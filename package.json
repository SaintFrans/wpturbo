{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "db:fresh": "php artisan migrate:fresh",
        "db:fresh:seed": "php artisan migrate:fresh --seed",
        "db:migrate": "php artisan migrate",
        "db:rollback": "php artisan migrate:rollback",
        "db:seed": "php artisan db:seed",
        "db:status": "php artisan migrate:status",
        "dev": "php artisan dev",
        "format": "vp fmt resources/",
        "format:check": "vp fmt --check resources/",
        "lint": "vp lint . --fix",
        "lint:check": "vp lint .",
        "types:check": "tsc --noEmit",
        "prepare": "vp config"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "vite-plus": "catalog:"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "globals": "^15.14.0",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^0.475.0",
        "react": "^19.2.0",
        "react-aria-components": "^1.20.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "catalog:"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.16.0",
            "onFail": "download"
        }
    }
}
